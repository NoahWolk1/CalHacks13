# Copy to .env.local (cp .env.example .env.local). All keys are optional.

# Claude powers the orchestrator's planning, cross-reference insights and written answers.
# Leave blank to run in heuristic mode (keyword planner + rule-based insights).
ANTHROPIC_API_KEY=

# Optional model override. Defaults to claude-opus-5-5.
CLAUDE_MODEL=

# Free key from https://api.census.gov/data/key_signup.html
# Enables Census Rover's income / rent / renter-share stats (without it, it only reports the tract).
CENSUS_API_KEY=
