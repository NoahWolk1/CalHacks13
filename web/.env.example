# Copy to .env.local (cp .env.example .env.local). All keys are optional.

# Claude powers the orchestrator's planning, cross-reference insights and written answers.
# Leave blank to run in heuristic mode (keyword planner + rule-based insights).
ANTHROPIC_API_KEY=

# Optional model override. Defaults to claude-opus-5-5.
CLAUDE_MODEL=

# Free key from https://api.census.gov/data/key_signup.html
# Enables Census Rover's income / rent / renter-share stats (without it, it only reports the tract).
CENSUS_API_KEY=

# Live shared mission state (runs, ordered event log, findings, LLM rate limits).
# spacetime | convex | sse. Default: spacetime if SPACETIME_DB + SPACETIME_TOKEN are set,
# else convex if NEXT_PUBLIC_CONVEX_URL is set, else sse (no shared state).
LIVE_BACKEND=

# SpacetimeDB (primary). Module: web/spacetime. Local: npm run spacetime:start, then
# npm run spacetime:publish:local and npm run spacetime:writer -- --server local.
# Maincloud: SPACETIME_HOST=https://maincloud.spacetimedb.com, SPACETIME_DB=geoswarm.
SPACETIME_HOST=http://127.0.0.1:3000
SPACETIME_DB=
# Server-only secret: the token minted by scripts/spacetime-writer.mjs (allowlisted writer identity).
SPACETIME_TOKEN=
# Optional browser overrides (default: same host/db as above, reported by /api/agents).
NEXT_PUBLIC_SPACETIME_HOST=
NEXT_PUBLIC_SPACETIME_DB=

# Convex (fallback). `npx convex dev` writes this (plus CONVEX_DEPLOYMENT) into .env.local.
NEXT_PUBLIC_CONVEX_URL=
