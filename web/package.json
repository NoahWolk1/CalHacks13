{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "build:vercel": "if [ -n \"$CONVEX_DEPLOY_KEY\" ]; then npx convex deploy --cmd 'npm run build'; else npm run build; fi",
    "start": "next start",
    "lint": "eslint",
    "warm": "node scripts/warm.mjs",
    "spacetime:start": "spacetime start --listen-addr 127.0.0.1:3000",
    "spacetime:publish:local": "spacetime publish geoswarm --server local --module-path spacetime --yes",
    "spacetime:publish:cloud": "spacetime publish ${SPACETIME_DB:-geoswarm} --server maincloud --module-path spacetime --yes",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir src/spacetime_bindings --module-path spacetime --yes",
    "spacetime:writer": "node scripts/spacetime-writer.mjs",
    "test": "vitest run",
    "apify:login": "npx -y -p apify-cli@1.10.0 apify login",
    "apify:push": "cd apify/actors/sf-planning-notices && npx -y -p apify-cli@1.10.0 apify push",
    "apify:run:local": "cd apify/actors/sf-planning-notices && npm install --silent && node src/main.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@deck.gl/core": "~9.4.0",
    "@deck.gl/extensions": "~9.4.0",
    "@deck.gl/geo-layers": "~9.4.0",
    "@deck.gl/layers": "~9.4.0",
    "@deck.gl/mapbox": "~9.4.0",
    "@mapbox/vector-tile": "^3.0.0",
    "@turf/turf": "^7.4.0",
    "astronomy-engine": "^2.1.19",
    "convex": "^1.48.0",
    "fast-xml-parser": "^5.11.2",
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^5.24.0",
    "next": "15.5.28",
    "pbf": "^5.1.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "satellite.js": "^5.0.0",
    "spacetimedb": "^2.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/mapbox__vector-tile": "^1.3.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
